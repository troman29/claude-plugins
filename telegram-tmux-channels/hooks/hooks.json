{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task|spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts describe",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts bg",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^Skill$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts skill",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts start",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts stop",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^TaskCreate$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts task-create",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^TaskUpdate$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts task-update",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^TodoWrite$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts todo",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^update_plan$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts codex-plan",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts codex-skill",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts turnend",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts compaction-start",
            "timeout": 3
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/src/subagent-hook.ts compaction-done",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
